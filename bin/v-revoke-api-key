#!/bin/bash
# info: revokes api key
# options: [HASH]
#
# example: v-revoke-api-key mykey
#
# This function removes a key from in $LOKAHOSTCP/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/lokahostcp/lokahostcp.conf
source /etc/lokahostcp/lokahostcp.conf
# shellcheck source=/usr/local/lokahostcp/func/main.sh
source $LOKAHOSTCP/func/main.sh
# load config file
source_conf "$LOKAHOSTCP/conf/lokahostcp.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

hash=$1

args_usage='HASH'
check_args '1' "$#" "$args_usage"
is_format_valid 'hash'

# Perform verification if read-only mode is enabled
check_lokahostcp_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$LOKAHOSTCP/data/keys/" ]; then
	exit "$E_NOTEXIST"
fi

if [[ -e "$LOKAHOSTCP/data/keys/$hash" ]]; then
	rm $LOKAHOSTCP/data/keys/$hash
else
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Lokahostcp                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "System API key revoked (Key: $hash)."
log_event "$OK" "$ARGUMENTS"

exit
