#!/bin/bash
# info: delete access key
# options: ACCESS_KEY_ID
#
# example: v-delete-access-key mykey
#
# This function removes a key from in $LOKAHOSTCP/data/access-keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/lokahostcp/lokahostcp.conf
source /etc/lokahostcp/lokahostcp.conf
# shellcheck source=/usr/local/lokahostcp/func/main.sh
source $LOKAHOSTCP/func/main.sh
# load config file
source_conf "$LOKAHOSTCP/conf/lokahostcp.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

access_key_id=$1

check_args '1' "$#" "ACCESS_KEY_ID"
is_format_valid 'access_key_id'
is_object_valid 'key' 'KEY' "$access_key_id"

# Perform verification if read-only mode is enabled
check_lokahostcp_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$LOKAHOSTCP/data/access-keys/" ]; then
	exit "$E_NOTEXIST"
fi

if [[ -e "${LOKAHOSTCP}/data/access-keys/${access_key_id}" ]]; then
	source_conf "${LOKAHOSTCP}/data/access-keys/${access_key_id}"
	rm "${LOKAHOSTCP}/data/access-keys/${access_key_id}"
else
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Lokahostcp                             #
#----------------------------------------------------------#

# Logging
log_history "Access key $access_key_id deleted" "Info" "$USER" "API"
log_event "$OK" "$ARGUMENTS"

exit
