#!/bin/bash
# info: update white label logo's
# options: [DOWNLOAD]
#
# example: v-update-white-label-logo
#
# Replace Lokahostcp logos with User created logo's

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
download=${1-no}
reset=${2-no}

# Includes
# shellcheck source=/etc/lokahostcp/lokahostcp.conf
source /etc/lokahostcp/lokahostcp.conf
# shellcheck source=/usr/local/lokahostcp/func/main.sh
source "$LOKAHOSTCP/func/main.sh"
# load config file
source_conf "$LOKAHOSTCP/conf/lokahostcp.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$reset" = "yes" ]; then
	rm -rf "$LOKAHOSTCP/web/images/custom/"
fi

if [ -f "$LOKAHOSTCP/web/images/custom/logo.svg" ]; then
	cp -f "$LOKAHOSTCP/web/images/custom/logo.svg" "$LOKAHOSTCP/web/images/logo.svg"
elif [ ! -f "$LOKAHOSTCP/web/images/custom/logo.svg" ] && [ "$download" = "yes" ]; then
	download_file "https://raw.githubusercontent.com/lokahostcp/lokahostcp/release/web/images/logo.svg" "$LOKAHOSTCP/web/images/logo.svg"
fi

if [ -f "$LOKAHOSTCP/web/images/custom/logo.png" ]; then
	cp -f "$LOKAHOSTCP/web/images/custom/logo.png" "$LOKAHOSTCP/web/images/logo.png"
elif [ ! -f "$LOKAHOSTCP/web/images/custom/logo.png" ] && [ "$download" = "yes" ]; then
	download_file "https://raw.githubusercontent.com/lokahostcp/lokahostcp/release/web/images/logo.png" "$LOKAHOSTCP/web/images/logo.png"
fi

if [ -f "$LOKAHOSTCP/web/images/custom/logo-header.svg" ]; then
	cp -f "$LOKAHOSTCP/web/images/custom/logo-header.svg" "$LOKAHOSTCP/web/images/logo-header.svg"
elif [ ! -f "$LOKAHOSTCP/web/images/custom/logo-header.svg" ] && [ "$download" = "yes" ]; then
	download_file "https://raw.githubusercontent.com/lokahostcp/lokahostcp/release/web/images/logo-header.svg" "$LOKAHOSTCP/web/images/logo-header.svg"
fi

if [ -f "$LOKAHOSTCP/web/images/custom/favicon.png" ]; then
	cp -f "$LOKAHOSTCP/web/images/custom/favicon.png" "$LOKAHOSTCP/web/images/favicon.png"
elif [ ! -f "$LOKAHOSTCP/web/images/custom/favicon.png" ] && [ "$download" = "yes" ]; then
	download_file "https://raw.githubusercontent.com/lokahostcp/lokahostcp/release/web/images/favicon.png" "$LOKAHOSTCP/web/images/favicon.png"
fi

if [ -f "$LOKAHOSTCP/web/images/custom/favicon.ico" ]; then
	cp -f "$LOKAHOSTCP/web/images/custom/favicon.ico" "$LOKAHOSTCP/web/favicon.ico"
elif [ ! -f "$LOKAHOSTCP/web/images/custom/favicon.ico" ] && [ "$download" = "yes" ]; then
	download_file "https://raw.githubusercontent.com/lokahostcp/lokahostcp/release/web/favicon.ico" "$LOKAHOSTCP/web/favicon.ico"
fi

#----------------------------------------------------------#
#                       Lokahostcp                             #
#----------------------------------------------------------#

exit
