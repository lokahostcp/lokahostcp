#!/bin/bash
# info: generate api key
# options: NONE
#
# example: v-generate-api-key
#
# This function creates a key file in $LOKAHOSTCP/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/lokahostcp/lokahostcp.conf
source /etc/lokahostcp/lokahostcp.conf
# shellcheck source=/usr/local/lokahostcp/func/main.sh
source $LOKAHOSTCP/func/main.sh
# load config file
source_conf "$LOKAHOSTCP/conf/lokahostcp.conf"

keygen() {
	tr < /dev/urandom -dc _A-Z-a-z-0-9 | head -c 32
	echo
}
HASH=$(keygen)

# Perform verification if read-only mode is enabled
check_lokahostcp_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$LOKAHOSTCP/data/keys/" ]; then
	mkdir -p $LOKAHOSTCP/data/keys/
	chown lokahostcpweb:root $LOKAHOSTCP/data/keys/
	chmod 750 $LOKAHOSTCP/data/keys/
fi

if [[ -e "$LOKAHOSTCP/data/keys/$HASH" ]]; then
	while [[ -e "$LOKAHOSTCP/data/keys/$HASH" ]]; do
		HASH=$(keygen)
	done
fi

touch $LOKAHOSTCP/data/keys/$HASH
echo "$HASH"

#----------------------------------------------------------#
#                       Lokahostcp                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "System" "New system API key generated (Key: ${HASH})."

exit
