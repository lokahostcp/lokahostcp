#!/bin/bash
# info: delete web terminal
# options: NONE
#
# example: v-delete-sys-web-terminal
#
# This function disables the web terminal.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/lokahostcp/lokahostcp.conf
source /etc/lokahostcp/lokahostcp.conf
# shellcheck source=/usr/local/lokahostcp/func/main.sh
source $LOKAHOSTCP/func/main.sh
# load config file
source_conf "$LOKAHOSTCP/conf/lokahostcp.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$WEB_TERMINAL" ]; then
	exit
fi

# Perform verification if read-only mode is enabled
check_lokahostcp_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Updating WEB_TERMINAL value
$BIN/v-change-sys-config-value "WEB_TERMINAL" "false"

# Stopping web terminal websocket server
$BIN/v-stop-service "lokahostcp-web-terminal"
systemctl disable lokahostcp-web-terminal

#----------------------------------------------------------#
#                       Lokahostcp                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "Web Terminal" "Web terminal disabled."
log_event "$OK" "$ARGUMENTS"

exit
