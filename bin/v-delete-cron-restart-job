#!/bin/bash
# info: delete restart job
# options: NONE
#
# This function for disabling restart cron tasks

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/lokahostcp/lokahostcp.conf
source /etc/lokahostcp/lokahostcp.conf
# shellcheck source=/usr/local/lokahostcp/func/main.sh
source $LOKAHOSTCP/func/main.sh
# load config file
source_conf "$LOKAHOSTCP/conf/lokahostcp.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'

# Perform verification if read-only mode is enabled
check_lokahostcp_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Add cron job
cmd="v-update-sys-queue restart"
check_cron=$(grep "$cmd" "/var/spool/cron/crontabs/lokahostcpweb" 2> /dev/null)
if [ -n "$check_cron" ]; then
	sed -i "/v-update-sys-queue restart/d" "/var/spool/cron/crontabs/lokahostcpweb"
fi

#----------------------------------------------------------#
#                       Lokahostcp                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
